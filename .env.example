# EarthScope AI configuration — copy this file to ".env" and fill in what you have.
# The app works without any keys (NASA POWER, GISTEMP, EONET, GIBS and MODIS/ORNL need none).

# --- AI Science Assistant (optional). Without it the assistant runs in DEMO MODE (offline explainer).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- NASA FIRMS active fires (optional, free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# --- NASA API key for asteroid data (optional, free): https://api.nasa.gov
# Without it the shared DEMO_KEY is used (about 30 requests per hour).
NASA_API_KEY=

# --- Storage and networking (optional)
# DATABASE_PATH=data/earthscope.db
# CACHE_HOURS=24
# HTTP_TIMEOUT=45
